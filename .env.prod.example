# ============================================
# CareConnect Production Environment Variables
# ============================================

# Database Configuration
POSTGRES_DB=careconnect_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# JWT Configuration
JWT_SECRET=test
JWT_EXPIRES_IN=7d

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://careconnect.com,https://www.careconnect.com

# Frontend URL (for CORS fallback)
VITE_API_URL=https://api.careconnect.com

# Logging
LOG_LEVEL=info

# Ports
FRONTEND_PORT=80
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

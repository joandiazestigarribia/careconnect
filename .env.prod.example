# ============================================
# CareConnect Production Environment Variables
# ============================================

# Database Configuration
POSTGRES_DB=careconnect_db
POSTGRES_USER=postgres
# Generate a secure password with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# JWT Configuration
JWT_SECRET=3sdQf226FPOpHQQu2ux2zY3fTrhP3u4+VfqZfMO/2bU=
JWT_EXPIRES_IN=7d

# Cookie Secret for signing cookies (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
COOKIE_SECRET=

# CORS Configuration
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://careconnect.com,https://www.careconnect.com

# Frontend URL (for CORS fallback)
VITE_API_URL=https://api.careconnect.com

# Logging
LOG_LEVEL=info

# Ports
FRONTEND_PORT=80
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
